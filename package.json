{
  "name": "campusconnect",
  "version": "1.0.0",
  "description": "CampusConnect — Smart Lost & Found Management System for College Campuses",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "campusconnect",
    "lost-and-found",
    "mern-stack",
    "college-project"
  ],
  "author": "CampusConnect Team",
  "license": "MIT"
}
