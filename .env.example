# ===================================================================
# CampusConnect — Vercel Environment Variables Configuration Guide
# ===================================================================
# In your Vercel Project Dashboard:
# Go to: Settings -> Environment Variables and add these keys:

# --- REQUIRED: Database Connection ---
# MongoDB Atlas Connection String (free cluster at mongodb.com)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusconnect?retryWrites=true&w=majority

# --- REQUIRED: Security & Auth Secrets ---
# Replace with secure random strings (e.g., generate via openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_32_characters_long
COOKIE_SECRET=replace_with_a_secure_random_cookie_secret_32_chars
JWT_EXPIRES_IN=7d
NODE_ENV=production

# --- OPTIONAL: Campus Domain Restriction ---
# If you want to restrict registration to a specific college domain (e.g. sreyas.ac.in)
ALLOWED_EMAIL_DOMAIN=

# --- OPTIONAL: Firebase Web Auth Config ---
# Firebase Authentication is already pre-configured with campus fallback defaults.
# If you want to connect your own Firebase project, uncomment and set these:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
